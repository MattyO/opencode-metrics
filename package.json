{
  "name": "opencode-tracing",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode plugin that traces agent calls, tool calls, and subagent sessions as OpenTelemetry spans sent to Grafana Tempo",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "latest",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.200.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.200.0",
    "@opentelemetry/otlp-grpc-exporter-base": "^0.200.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.34.0",
    "lodash": "^4.18.1",
    "zustand": "^5.1.0"
  },
  "scripts": {
    "test": "rstest --reporters verbose",
    "test:coverage": "rstest --reporters verbose --coverage",
    "build": "rsbuild",
    "ci:build": "rsbuild build",
    "restart-opencode-server": "opencode service restart"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.3.3",
    "@rstest/adapter-rsbuild": "^0.12.6",
    "@rstest/core": "^0.12.6",
    "@rstest/coverage-v8": "^0.12.6",
    "@types/lodash": "^4.17.27",
    "typescript": "^7.0.2"
  }
}
